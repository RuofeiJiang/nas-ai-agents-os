# AAOS-NAS 配置文件目录(Docker 挂载用)
# 复制到宿主机 ./config/ 后用 docker compose up

# 火山方舟 ARK API Key
ARK_API_KEY=

# HomeAssistant Token
HA_TOKEN=

# Alist 配置
ALIST_URL=http://localhost:5244
ALIST_USER=admin
ALIST_PASS=

# qBittorrent 配置(可选)
QBIT_HOST=http://localhost:8080
QBIT_USER=admin
QBIT_PASS=adminadmin

# TMDB API Key(可选)
TMDB_API_KEY=
